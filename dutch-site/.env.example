# Public site origin used for origin checks, canonical URLs and the sitemap.
# Beoogde Nederlandse productiesite: https://your-domain.example.com
SITE_URL=

# Optional extra allowed origins, comma-separated.
SITE_ORIGINS=

# resend | mock
# Development defaults to mock if unset. Production must use resend with a
# verified sender domain. Mock mode never reports a simulated send as live.
ENQUIRY_DELIVERY_MODE=mock

# Server-only Resend credentials. Do not expose these to the browser.
RESEND_API_KEY=
ENQUIRY_FROM_EMAIL=
# Optional alias for ENQUIRY_FROM_EMAIL
RESEND_FROM_EMAIL=
ENQUIRY_TO_EMAIL=

# Persistent rate-limit and idempotency store. Required in production.
# Do not use an in-memory Map as production protection.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

RATE_LIMIT_MAX=5
RATE_LIMIT_WINDOW_SECONDS=600

# Set true only on a platform that overwrites forwarded-for, such as Vercel
# (VERCEL=1 is detected automatically).
TRUST_PROXY=false

# Optional public contact email shown in the footer. Leave empty to omit.
NEXT_PUBLIC_CONTACT_EMAIL=

# Optional Google Analytics 4. Both values are required; the tag loads only after consent.
NEXT_PUBLIC_ANALYTICS_ENABLED=false
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Future Google Ads conversion ID. Leave empty until a conversion action exists.
NEXT_PUBLIC_GOOGLE_ADS_CONVERSION_ID=
